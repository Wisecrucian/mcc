#!/bin/sh

APP_NAME="Gradle"
APP_BASE_NAME=$(basename "$0")

GRADLE_USER_HOME="${GRADLE_USER_HOME:-${HOME}/.gradle}"

DEFAULT_JVM_OPTS="-Xmx64m -Xms64m"

APP_HOME=$(pwd -P)

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

exec "/Users/max/Library/Java/JavaVirtualMachines/corretto-21.0.4/Contents/Home/bin/java" $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS "-Dorg.gradle.appname=$APP_BASE_NAME" -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
