<idea-plugin>
    <id>com.mcc.portforwarder</id>
    <name>MCC Port Forwarder</name>
    <vendor email="support@example.com" url="https://example.com">MCC</vendor>

    <description><![CDATA[
    <h1>MCC Port Forwarder</h1>
    <p>Manage port forwarding connections directly from IntelliJ IDEA.</p>
    
    <h2>Features:</h2>
    <ul>
      <li>Manage services and hosts hierarchically</li>
      <li>Multiple port mappings per host</li>
      <li>Multi-datacenter support with location templates</li>
      <li>Real-time connection status tracking</li>
      <li>Start/stop individual ports or entire services</li>
      <li>Auto-retry on connection failure</li>
      <li>Kill blocking processes on ports</li>
      <li>Configuration import/export</li>
      <li>Detailed logging per port</li>
    </ul>
    
    <h2>Status Indicators:</h2>
    <ul>
      <li>🔵 Connecting - Process started</li>
      <li>🟡 Authenticating - Authentication in progress</li>
      <li>🟢 Ready - Connection established</li>
      <li>🔴 Error - Connection failed</li>
      <li>🟠 Timeout - Connection timeout</li>
      <li>🟠 Port Busy - Port already in use</li>
      <li>🔄 Restarting - Auto-retry in progress</li>
      <li>🟣 Disconnected - Connection dropped</li>
    </ul>
    ]]></description>

    <change-notes><![CDATA[
    <h2>Version 1.0.0</h2>
    <ul>
      <li>Initial release</li>
      <li>Service and host management</li>
      <li>Multi-datacenter support</li>
      <li>Real-time status tracking</li>
      <li>Configuration import/export</li>
    </ul>
    ]]></change-notes>

    <!-- Product and plugin compatibility requirements -->
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Tool Window -->
        <toolWindow
                id="MCC Port Forwarder"
                anchor="right"
                icon="/icons/toolWindowIcon.svg"
                factoryClass="com.mcc.portforwarder.toolwindow.MCCToolWindowFactory"/>

        <!-- Application Service -->
        <applicationService
                serviceImplementation="com.mcc.portforwarder.services.MCCPortForwarderService"/>

        <!-- Settings -->
        <applicationConfigurable
                parentId="tools"
                instance="com.mcc.portforwarder.settings.MCCSettingsConfigurable"
                id="com.mcc.portforwarder.settings"
                displayName="MCC Port Forwarder"/>
    </extensions>

    <actions>
        <!-- Toolbar actions -->
        <group id="MCCPortForwarder.ToolbarActions" text="MCC Port Forwarder" popup="true">
            <action id="MCCPortForwarder.StartAll"
                    class="com.mcc.portforwarder.actions.StartAllAction"
                    text="Start All Services"
                    description="Start all configured services"
                    icon="AllIcons.Actions.Execute"/>
            <action id="MCCPortForwarder.StopAll"
                    class="com.mcc.portforwarder.actions.StopAllAction"
                    text="Stop All Services"
                    description="Stop all running services"
                    icon="AllIcons.Actions.Suspend"/>
            <separator/>
            <action id="MCCPortForwarder.Login"
                    class="com.mcc.portforwarder.actions.LoginAction"
                    text="Login"
                    description="Execute login command"
                    icon="AllIcons.Actions.Lightning"/>
            <action id="MCCPortForwarder.Logout"
                    class="com.mcc.portforwarder.actions.LogoutAction"
                    text="Logout"
                    description="Execute logout command"
                    icon="AllIcons.Actions.Cancel"/>
        </group>
    </actions>
</idea-plugin>

