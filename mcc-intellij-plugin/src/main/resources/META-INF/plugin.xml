<idea-plugin>
    <id>com.mcc.portforwarder</id>
    <name>MCC Port Forwarder</name>
    <vendor>MCC</vendor>
    
    <description><![CDATA[
        <p>Manage SSH port forwarding with ease.</p>
        <ul>
            <li>Hierarchical service and host management</li>
            <li>Multi-location datacenter support</li>
            <li>Real-time process monitoring</li>
            <li>Configuration import/export</li>
            <li>Automatic retry on failure</li>
        </ul>
    ]]></description>
    
    <depends>com.intellij.modules.platform</depends>
    
    <!-- Application-level services -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- Settings Service -->
        <applicationService 
            serviceImplementation="com.mcc.portforwarder.services.MCCSettings"/>
        
        <!-- Storage Service -->
        <applicationService 
            serviceImplementation="com.mcc.portforwarder.services.MCCStorage"/>
        
        <!-- Project-level Service -->
        <projectService 
            serviceImplementation="com.mcc.portforwarder.services.MCCService"/>
        
        <!-- Tool Window -->
        <toolWindow
            id="MCCPortForwarder"
            anchor="right"
            factoryClass="com.mcc.portforwarder.toolwindow.MCCToolWindowFactory"
            icon="AllIcons.Toolwindows.ToolWindowRun"/>
    </extensions>
</idea-plugin>
