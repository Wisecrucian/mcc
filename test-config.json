{
  "version": "1.0",
  "exportDate": "2026-02-11T10:30:00Z",
  "services": [
    {
      "name": "Production Services",
      "hosts": [
        {
          "name": "PostgreSQL Master",
          "hostnameTemplate": "postgres.prod.{location}.example.com",
          "remotePort": 5432,
          "locations": [
            {
              "datacenter": "hc",
              "localPort": 9001
            },
            {
              "datacenter": "kc",
              "localPort": 9002
            }
          ]
        },
        {
          "name": "Redis Cache",
          "hostnameTemplate": "redis.prod.{location}.example.com",
          "remotePort": 6379,
          "locations": [
            {
              "datacenter": "hc",
              "localPort": 9101
            },
            {
              "datacenter": "kc",
              "localPort": 9102
            },
            {
              "datacenter": "pc",
              "localPort": 9103
            }
          ]
        }
      ],
      "childServices": [
        {
          "name": "Monitoring",
          "hosts": [
            {
              "name": "Prometheus",
              "hostnameTemplate": "prometheus.monitoring.{location}.example.com",
              "remotePort": 9090,
              "locations": [
                {
                  "datacenter": "hc",
                  "localPort": 9201
                }
              ]
            }
          ],
          "childServices": []
        }
      ]
    },
    {
      "name": "Development Services",
      "hosts": [
        {
          "name": "MySQL Dev",
          "hostnameTemplate": "mysql.dev.{location}.example.com",
          "remotePort": 3306,
          "locations": [
            {
              "datacenter": "hc",
              "localPort": 9301
            }
          ]
        }
      ],
      "childServices": []
    }
  ],
  "settings": {
    "command": "/usr/local/bin/mcc tp-port-forward",
    "loginCommand": "/usr/local/bin/mcc login",
    "logoutCommand": "/usr/local/bin/mcc logout",
    "retryEnabled": true,
    "retryAttempts": 5,
    "retryDelay": 3,
    "datacenters": [
      "hc",
      "kc",
      "pc"
    ]
  }
}



